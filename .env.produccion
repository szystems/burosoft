# ============================================
# CONFIGURACIÓN PRODUCCIÓN - IPAGE
# Aplicación: BuroTributario
# Dominio: appburo.burotributario.com
# Servidor: iPage Hosting Compartido
# Laravel: 12.40.1
# PHP: 8.3.16
# ============================================

# APLICACIÓN
APP_NAME="BuroTributario"
APP_ENV=production
APP_KEY=base64:75f2jpCWbFz+pUpV6TuFM9Mcc2ZhG3r8XjaPa8zv4ck=
APP_DEBUG=false
APP_URL=https://appburo.burotributario.com

# LOGS OPTIMIZADOS PARA PRODUCCIÓN
# Use 'single' para debugging temporal, 'daily' para producción normal
LOG_CHANNEL=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error
LOG_DAYS=14

# BASE DE DATOS - iPAGE MYSQL
DB_CONNECTION=mysql
DB_HOST=szclinicascom.ipagemysql.com
DB_PORT=3306
DB_DATABASE=dbburonuevo
DB_USERNAME=sz
DB_PASSWORD=SPP7007aaa@@@

# CONFIGURACIÓN OPTIMIZADA PARA iPAGE (HOSTING COMPARTIDO)
BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DRIVER=local
QUEUE_CONNECTION=sync

# SESIONES CRÍTICAS PARA iPAGE - CONFIGURACIÓN ANTI ERROR 419
SESSION_DRIVER=file
SESSION_LIFETIME=480
SESSION_COOKIE=appburo_session
SESSION_DOMAIN=.burotributario.com
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_ENCRYPT=false
SESSION_EXPIRE_ON_CLOSE=false
SESSION_COOKIE_HTTPONLY=true

# CACHE Y OPTIMIZACIÓN
CACHE_PREFIX=appburo_cache
CACHE_STORE=file

# REDIS (No disponible en iPage compartido - mantener configuración por defecto)
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# MEMCACHED (No disponible en iPage compartido)
MEMCACHED_HOST=127.0.0.1

# CONFIGURACIÓN DE CORREO - iPAGE SMTP
MAIL_MAILER=smtp
MAIL_HOST=smtp.ipage.com
MAIL_PORT=465
MAIL_USERNAME=soluciones@burotributario.com
MAIL_PASSWORD=@BuroS123
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=soluciones@burotributario.com
MAIL_FROM_NAME="${APP_NAME}"

# AWS (Deshabilitado)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# PUSHER (Deshabilitado)
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# PAYPAL - PRODUCCIÓN (CAMBIAR A LIVE CUANDO ESTÉ LISTO)
# SANDBOX para pruebas, cambiar a https://api.paypal.com para producción real
PAYPAL_BASE_URI=https://api.sandbox.paypal.com
PAYPAL_CLIENT_ID=AVqk2pRzAOBVOl1HPuShEDPwGT9Yv8Ql6Wk5Wrw_tCdKdodr-YumQ0s0Vi7enQKQuUqVJoLoSwldLTjI
PAYPAL_CLIENT_SECRET=ELK0HwaTvheBA0FRTZ84fiCPv8L4dFPYA8W57uvy5j2fVU6TQKPfLjHrX-YYtgzNE0xYMKiRif_tCAJC
PAYPAL_MONTHLY_PLAN=P-4PL544017R6426355MVXGBAA
PAYPAL_YEARLY_PLAN=P-7TL936212G3173539MV6IGZY
PAYPAL_SEMIANNUAL_PLAN=P-2VE34332WU698500XMV44WHA

# OPTIMIZACIÓN PARA HOSTING COMPARTIDO iPAGE
# Estas configuraciones ayudan con el rendimiento en servidores compartidos
OCTANE_SERVER=
OCTANE_HTTPS=on

# TIMEZONE
APP_TIMEZONE=America/Guatemala
APP_LOCALE=es
APP_FALLBACK_LOCALE=en

# CONFIGURACIÓN DE COOKIES SEGURAS
SANCTUM_STATEFUL_DOMAINS=appburo.burotributario.com,www.appburo.burotributario.com
SESSION_DOMAIN=.burotributario.com

# LÍMITES DE RECURSOS PARA HOSTING COMPARTIDO
MYSQL_ATTR_TIMEOUT=30
MYSQL_ATTR_CONNECT_TIMEOUT=10
DB_TIMEOUT=30
